{
    "name": "knights-of-darkness-simulation",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Drives the game server over HTTP to simulate whole worlds: invariants, balance checks and A/B balance reports",
    "scripts": {
        "test": "node --test --test-concurrency=1 \"scenarios/*.test.ts\"",
        "sim": "node src/cli.ts",
        "stages": "node src/stages.ts",
        "coalitions": "node src/coalitions.ts",
        "typecheck": "tsc --noEmit",
        "api:types": "openapi-typescript ../api/openapi.json --output src/schema.ts",
        "api:check": "npm run api:types && git diff --exit-code -- src/schema.ts"
    },
    "devDependencies": {
        "@types/node": "26.6.6",
        "openapi-typescript": "7.13.0",
        "playwright-core": "1.65.0",
        "typescript": "6.0.3"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
