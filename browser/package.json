{
    "name": "knights-of-darkness-browser",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:types": "tsc -b",
        "build:watch": "tsc -b --watch",
        "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\" --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"e2e/**/*.ts\" playwright.config.ts",
        "ci:lint": "npm run lint && npm run format:check",
        "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"e2e/**/*.ts\" playwright.config.ts",
        "preview": "vite preview",
        "test:e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/grenze-gotisch": "5.3.0",
        "@fontsource/alegreya-sans": "5.3.0",
        "react": "^18.3.1",
        "react-dom": "^18.3.1",
        "react-router-dom": "^7.18.4"
    },
    "devDependencies": {
        "@eslint/js": "^9.23.0",
        "@playwright/test": "1.64.1",
        "@types/babel__generator": "^7.27.0",
        "@types/babel__template": "^7.4.4",
        "@types/babel__traverse": "^7.28.0",
        "@types/prop-types": "^15.7.15",
        "@types/react": "^18.3.31",
        "@types/react-dom": "^18.3.7",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^9.39.5",
        "eslint-import-resolver-typescript": "^4.4.5",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.26",
        "globals": "^16.5.0",
        "prettier": "^3.9.10",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.71.2",
        "vite": "^8.3.4"
    }
}
