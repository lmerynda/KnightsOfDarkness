{
    "name": "knights-of-darkness-browser",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "build:types": "tsc -b",
        "build:watch": "tsc -b --watch",
        "lint": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\"",
        "lint:fix": "eslint \"src/**/*.{js,mjs,cjs,ts,jsx,tsx}\" --fix",
        "format": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"e2e/**/*.ts\" playwright.config.ts",
        "ci:lint": "npm run lint && npm run format:check",
        "format:check": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,md}\" \"e2e/**/*.ts\" playwright.config.ts",
        "preview": "vite preview",
        "test:e2e": "playwright test",
        "api:types": "openapi-typescript ../api/openapi.json --output src/api/schema.ts && prettier --write src/api/schema.ts",
        "api:check": "npm run api:types && git diff --exit-code -- src/api/schema.ts"
    },
    "dependencies": {
        "@fontsource-variable/grenze": "5.3.0",
        "@fontsource-variable/grenze-gotisch": "5.3.0",
        "@fontsource/alegreya-sans": "5.3.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router-dom": "^7.18.5"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "1.64.1",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.13.0",
        "openapi-typescript": "7.13.0",
        "prettier": "^3.9.10",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vite": "^8.3.5"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
