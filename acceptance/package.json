{
    "name": "knights-of-darkness-acceptance",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "description": "Black-box tests of the whole game in its own words: domain scenarios through the HTTP API and through Chrome, worlds of scripted rulers, and months of eras",
    "scripts": {
        "test": "node src/run.ts api",
        "test:browser": "node src/run.ts browser",
        "test:long": "node src/run.ts long",
        "test:balance": "node src/run.ts balance",
        "test:pg": "node src/run.ts robustness-pg",
        "sim": "node src/simulation/cli.ts",
        "stages": "node src/simulation/stages.ts",
        "coalitions": "node src/simulation/coalitions.ts",
        "economy": "node src/simulation/economy.ts",
        "typecheck": "tsc --noEmit",
        "api:types": "openapi-typescript ../api/openapi.json --output src/api/schema.ts",
        "api:check": "npm run api:types && git diff --exit-code -- src/api/schema.ts"
    },
    "devDependencies": {
        "@types/node": "26.6.10",
        "openapi-typescript": "7.13.0",
        "playwright-core": "1.65.1",
        "typescript": "6.0.3"
    },
    "overrides": {
        "openapi-typescript": {
            "typescript": "$typescript"
        }
    }
}
